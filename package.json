{
  "name": "@bitpay/qr-code",
  "version": "0.0.1",
  "description": "BitPay's QR Code Web Component",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "exports": {
    ".": {
      "import": "./dist/bp-qr-code/bp-qr-code.esm.js",
      "require": "./dist/bp-qr-code/bp-qr-code.cjs.js"
    },
    "./bp-qr-code": {
      "import": "./dist/components/bp-qr-code.js",
      "types": "./dist/components/bp-qr-code.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build --prod && npm run csp:check",
    "watch": "stencil build --dev --watch",
    "watch:prod": "stencil build --watch --prod",
    "start": "npm run watch",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --watch",
    "test:csp": "node scripts/csp-browser-test.mjs",
    "csp:check": "node scripts/check-csp.mjs",
    "ci": "npm test && npm run build && npm run test:csp"
  },
  "dependencies": {
    "just-animate": "2.6.2",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@stencil/core": "4.44.2",
    "@stencil/vitest": "1.14.0",
    "@types/node": "^24.6.2",
    "playwright": "1.63.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitpay/qr-code.git"
  },
  "author": "BitPay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bitpay/qr-code/issues"
  },
  "homepage": "https://github.com/bitpay/qr-code"
}
